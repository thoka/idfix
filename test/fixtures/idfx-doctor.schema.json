{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dv.invalid/idfx/idfx-doctor.schema.json",
  "description": "The output of idfx doctor --json: one object of the doctor format of the shared tool protocol, version 0. fixes exists only with --fix.",
  "type": "object",
  "required": ["tool", "version", "status", "checks"],
  "additionalProperties": false,
  "properties": {
    "tool": { "const": "idfx" },
    "version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pass", "warn", "fail"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "status", "type", "message", "fix"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "status": { "enum": ["pass", "warn", "fail", "skip", "error"] },
          "type": { "type": "string", "pattern": "^urn:dv:idfx:doctor:[a-z][a-z0-9-]*$" },
          "message": { "type": "string" },
          "fix": { "type": "string" },
          "error": { "type": "string" }
        }
      }
    },
    "fixes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "ok", "note"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "ok": { "type": "boolean" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
