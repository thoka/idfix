#!/usr/bin/env bash
# idfx launcher. Claude Code puts the plugin's bin/ folder on the PATH of
# its Bash tool, so this script runs as the bare command `idfx`. It also
# works as a symlink, for example from ~/.local/bin/idfx.
set -euo pipefail

root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

# Use bun from the PATH. If it is missing, ask mise for the pinned version.
if command -v bun >/dev/null 2>&1 && bun --version >/dev/null 2>&1; then
  bun_cmd=(bun)
elif command -v mise >/dev/null 2>&1; then
  version="$(sed -n 's/^bun *= *"\(.*\)"/\1/p' "$root/mise.toml")"
  bun_cmd=(mise exec "bun@${version:-latest}" -- bun)
else
  echo "idfx: bun is not installed. Install bun (https://bun.sh) or mise." >&2
  exit 1
fi

# Install the locked runtime dependencies only when the lockfile changed. A
# plugin that Claude Code copied into its cache has no node_modules yet, and an
# update can add a package to bun.lock. The stamp holds a checksum of bun.lock
# and package.json and lives inside node_modules, so a missing folder also
# triggers the install. With a matching stamp, the launcher starts at once and
# prints nothing. The install output goes to stderr, so that stdout stays
# clean for the commands that print JSON.
stamp="$root/node_modules/.idfx-install-stamp"
want="$(cat "$root/bun.lock" "$root/package.json" 2>/dev/null | cksum)"
if [ "$(cat "$stamp" 2>/dev/null || true)" != "$want" ]; then
  (cd "$root" && "${bun_cmd[@]}" install --frozen-lockfile --production >&2)
  printf '%s\n' "$want" >"$stamp"
fi

# Pass the name the user called, so that the help shows it. Take the base
# name of $0, which keeps the name of a symlink such as ~/.local/bin/idfix.
export IDFX_PROG="${IDFX_PROG:-$(basename "$0")}"

# Run in production mode unless the user set NODE_ENV. Bun picks its JSX
# transform, and React picks its build, from NODE_ENV when the process starts,
# so it must be set here and not later. The development build of React keeps
# data of every render, and the live view of `top` leaked memory.
export NODE_ENV="${NODE_ENV:-production}"
exec "${bun_cmd[@]}" "$root/src/cli.ts" "$@"
