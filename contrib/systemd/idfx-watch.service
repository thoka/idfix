# The watcher of all Claude Code sessions of this machine, as a systemd user
# service. Design: .plan/design/idfx-watch.md, section 7. idfix ships this file;
# link or copy it into ~/.config/systemd/user/ and enable it. `idfx doctor`
# reports in the check `watch-running` whether it runs.

[Unit]
Description=idfx watch --all: watch the Claude Code sessions and wake the supervisor

[Service]
Type=simple
# A user service gets a short PATH. The watcher needs bun (or mise) for idfx,
# handover and notify-session, so the PATH names their folders. Change the
# second folder when these tools live elsewhere.
Environment=PATH=%h/.local/bin:%h/dv/meta/dv/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin
ExecStart=%h/.local/bin/idfx watch --all
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
